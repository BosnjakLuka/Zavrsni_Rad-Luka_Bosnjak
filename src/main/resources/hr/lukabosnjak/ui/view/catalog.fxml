<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.lukabosnjak.ui.controller.CatalogController">
    <content>
        <VBox spacing="14.0" style="-fx-background-color: #f7f8fa;">
            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/></padding>
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Katalog i postavke"/>
            <Label fx:id="currentUserLabel"/>
            <FlowPane alignment="TOP_LEFT" columnHalignment="LEFT" hgap="16.0" vgap="16.0"
                      prefWrapLength="760.0">
                <VBox minWidth="240.0" prefWidth="260.0" spacing="8.0"
                      style="-fx-background-color: white; -fx-border-color: #d9dde3; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/></padding>
                    <Label style="-fx-font-weight: bold;" text="Vrste materijala"/>
                    <ListView fx:id="materialTypesList" prefHeight="180.0" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="6.0">
                        <Button fx:id="addMaterialTypeButton" onAction="#handleAddMaterialType"
                                text="Dodaj" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleEditMaterialType" text="Uredi" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button fx:id="deactivateMaterialTypeButton" onAction="#handleToggleMaterialType"
                            text="Deaktiviraj / aktiviraj" maxWidth="1.7976931348623157E308"/>
                </VBox>
                <VBox minWidth="240.0" prefWidth="260.0" spacing="8.0"
                      style="-fx-background-color: white; -fx-border-color: #d9dde3; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/></padding>
                    <Label style="-fx-font-weight: bold;" text="CNC strojevi"/>
                    <ListView fx:id="machinesList" prefHeight="180.0" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="6.0">
                        <Button fx:id="addMachineButton" onAction="#handleAddMachine"
                                text="Dodaj" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleEditMachine" text="Uredi" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button fx:id="deactivateMachineButton" onAction="#handleToggleMachine"
                            text="Deaktiviraj / aktiviraj" maxWidth="1.7976931348623157E308"/>
                </VBox>
                <VBox minWidth="240.0" prefWidth="260.0" spacing="8.0"
                      style="-fx-background-color: white; -fx-border-color: #d9dde3; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/></padding>
                    <Label style="-fx-font-weight: bold;" text="Alati odabranog stroja"/>
                    <ListView fx:id="toolsList" prefHeight="180.0" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="6.0">
                        <Button fx:id="addToolButton" onAction="#handleAddTool"
                                text="Dodaj" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleEditTool" text="Uredi" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button fx:id="deactivateToolButton" onAction="#handleToggleTool"
                            text="Deaktiviraj / aktiviraj" maxWidth="1.7976931348623157E308"/>
                </VBox>
            </FlowPane>
            <Label fx:id="statusLabel" wrapText="true"/>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button onAction="#handleRefresh" text="Osvježi"/>
                <Button onAction="#handleBack" text="Natrag"/>
                <Button onAction="#handleLogout" text="Odjava"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
